+import test from 'node:test';import assert from 'node:assert/strict';
+import {authorized,snapshot} from '../lib/command-center.mjs';
+import {agreementText,digest} from '../lib/agreements.mjs';
+const c={id:'TEST',name:'Test Person',email:'test@example.com',address:'Test address',tokenHash:'never-expose',role:'band'};
+test('bridge fails closed for absent or incorrect bearer secret',async()=>{const hash=await digest('secret');assert.equal(await authorized(null,hash),false);assert.equal(await authorized('Bearer other',hash),false);assert.equal(await authorized('Bearer secret',hash),true);assert.equal(await authorized('Bearer secret',''),false)});
+test('snapshot preserves original acceptance text, omits tokens and distinguishes untracked views',async()=>{const text=agreementText(c),record={contract_id:c.id,full_name:c.name,email:c.email,agreement_text:text,agreement_hash:await digest(text),accepted_at:'2026-10-09T20:00:00Z',user_agent:'ua'};const p=await snapshot([c],[record],[],null,{});assert.equal(p.contracts[0].acceptance.text,text);assert.equal(p.contracts[0].views,null);assert.ok(!JSON.stringify(p).includes('never-expose'));assert.equal(p.contracts[0].acceptance.identityMethod,'private_link_and_typed_name');assert.equal(p.contracts[0].hash,record.agreement_hash)});
